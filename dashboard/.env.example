# =============================================================================
# B & K finance dashboard - environment variables
# Copy to .env (never commit .env). One file, three consumers:
#   [n8n]      self-hosted n8n container + the AutoCount Cloud workflow
#   [extract]  dashboard/ingestion/autocount-onprem/extract.py
#   [bi]       dashboard/bi/docker-compose.yml (Metabase)
# Secrets marked (secret) belong in a secrets manager / docker secrets in prod.
# =============================================================================

# ---------------------------------------------------------------------------
# Warehouse: the DEDICATED finance Supabase project (not the website project)
# ---------------------------------------------------------------------------
WAREHOUSE_SUPABASE_URL=https://<project-ref>.supabase.co
WAREHOUSE_SUPABASE_SERVICE_ROLE_KEY=                    # (secret) [n8n][extract] ingestion writes only. NEVER in a browser or Metabase.
WAREHOUSE_SUPABASE_ANON_KEY=                            # future custom board page only (RLS-protected reads)

# Direct Postgres connection for n8n Postgres node, extract.py and psql.
# Use the Supabase connection pooler host (session mode, port 5432) for long-running tools.
WAREHOUSE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
WAREHOUSE_DB_PORT=5432
WAREHOUSE_DB_NAME=postgres
WAREHOUSE_DB_USER=postgres.<project-ref>
WAREHOUSE_DB_PASSWORD=                                  # (secret) [n8n][extract]
WAREHOUSE_DB_SSLMODE=require
# Same thing as one URL (used by extract.py and the psql examples in the READMEs)
WAREHOUSE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# n8n (self-hosted) [n8n]
# ---------------------------------------------------------------------------
N8N_HOST=n8n.internal.example.my
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.internal.example.my/
N8N_ENCRYPTION_KEY=                                     # (secret) encrypts stored credentials; back it up
GENERIC_TIMEZONE=Asia/Kuala_Lumpur
TZ=Asia/Kuala_Lumpur
# The workflow's Code nodes read $env.AUTOCOUNT_CLOUD_* below. n8n blocks env
# access from Code nodes by default; this opens it (keep n8n private).
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ---------------------------------------------------------------------------
# AutoCount Cloud Accounting API [n8n]
# TODO-VERIFY: no public developer documentation for AutoCount Cloud
# Accounting was found. Obtain base URL, auth model and report endpoints from
# AutoCount (API for Integration is a listed plan feature) and fill these in.
# Endpoint values are PATHS appended to the base URL.
# ---------------------------------------------------------------------------
AUTOCOUNT_CLOUD_BASE_URL={{AUTOCOUNT_CLOUD_BASE_URL}}             # e.g. https://<tenant>.autocountcloud.com/api   (TODO-VERIFY)
AUTOCOUNT_CLOUD_AUTH_MODE=header                                  # header | oauth2 | token-exchange  (TODO-VERIFY which one the vendor uses)
AUTOCOUNT_CLOUD_API_KEY=                                          # (secret) stored in an n8n credential, kept here only for docker env injection
AUTOCOUNT_CLOUD_CLIENT_ID=                                        # if oauth2
AUTOCOUNT_CLOUD_CLIENT_SECRET=                                    # (secret) if oauth2
AUTOCOUNT_CLOUD_TB_ENDPOINT={{AUTOCOUNT_CLOUD_TB_ENDPOINT}}       # trial balance / GL balances by period   (TODO-VERIFY)
AUTOCOUNT_CLOUD_COA_ENDPOINT={{AUTOCOUNT_CLOUD_COA_ENDPOINT}}     # chart of accounts                      (TODO-VERIFY)
AUTOCOUNT_CLOUD_AR_AGING_ENDPOINT={{AUTOCOUNT_CLOUD_AR_AGING_ENDPOINT}}   # debtor aging                   (TODO-VERIFY)
AUTOCOUNT_CLOUD_AP_AGING_ENDPOINT={{AUTOCOUNT_CLOUD_AP_AGING_ENDPOINT}}   # creditor aging                 (TODO-VERIFY)
# Which warehouse entities are on AutoCount Cloud and their company/account-book id in the API.
# JSON array; entity_code must match public.entities.code.
AUTOCOUNT_CLOUD_ENTITIES=[{"entity_code":"BKA","company_ref":"<cloud-company-id>"},{"entity_code":"BKAC","company_ref":"<cloud-company-id>"}]
# How many months back to (re)pull trial balances each night. 2 = current + previous 2 (open months get restated).
AUTOCOUNT_CLOUD_LOOKBACK_MONTHS=2

# ---------------------------------------------------------------------------
# AutoCount Accounting on-premise (SQL Server) [extract]
# ---------------------------------------------------------------------------
AUTOCOUNT_SQL_SERVER=192.168.1.10\A2006                           # host or host\instance (AutoCount's default instance is often A2006; TODO-VERIFY on site)
AUTOCOUNT_SQL_PORT=1433
AUTOCOUNT_SQL_USER=bk_dash_ro                                     # read-only login created by queries/00_create_readonly_login.sql
AUTOCOUNT_SQL_PASSWORD=                                           # (secret)
AUTOCOUNT_SQL_DRIVER=ODBC Driver 18 for SQL Server
AUTOCOUNT_SQL_ENCRYPT=yes
AUTOCOUNT_SQL_TRUST_SERVER_CERTIFICATE=yes                        # set no once the SQL Server has a proper certificate
AUTOCOUNT_SQL_TIMEOUT_SECONDS=60
# entity_code -> AutoCount account-book database name (one DB per company in AutoCount)
AUTOCOUNT_ONPREM_ENTITIES={"BKTS":{"database":"AED_BKTS"},"HITS":{"database":"AED_HITS"}}
EXTRACT_LOOKBACK_MONTHS=2
EXTRACT_OUTPUT_DIR=./out                                          # CSV staging; rotate/purge, it contains ledger data
EXTRACT_LOG_LEVEL=INFO
EXTRACT_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Metabase [bi]
# ---------------------------------------------------------------------------
METABASE_VERSION=v0.52.8                                          # pin to a tag you have verified on hub.docker.com/r/metabase/metabase
METABASE_PORT=3000
MB_SITE_URL=https://bi.internal.example.my
JAVA_TIMEZONE=Asia/Kuala_Lumpur
# Metabase APPLICATION database (local Postgres container, holds Metabase's own settings/users; not the warehouse)
METABASE_APPDB_USER=metabase
METABASE_APPDB_PASSWORD=                                          # (secret)
METABASE_APPDB_NAME=metabase_app
# Read-only warehouse role Metabase uses to query the Supabase views (created in bi/README.md)
METABASE_RO_USER=metabase_ro
METABASE_RO_PASSWORD=                                             # (secret)
